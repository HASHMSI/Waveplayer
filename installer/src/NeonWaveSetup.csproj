<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>WavePlayerSetup</AssemblyName>
    <Version>1.1.2</Version>
    <InformationalVersion>1.1.2</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <FileVersion>1.1.2</FileVersion>
    <ApplicationIcon>..\..\src\SynthwaveNowPlaying\Assets\WavePlayer.ico</ApplicationIcon>
    <DefineConstants>$(DefineConstants);SETUP</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\..\src\SynthwaveNowPlaying\Updates\UpdatePackage.cs" Link="UpdatePackage.cs" />
    <Compile Include="..\..\src\SynthwaveNowPlaying\Updates\UpdateInstall.cs" Link="UpdateInstall.cs" />
    <Resource Include="$(ApplicationIcon)" Link="Assets\WavePlayer.ico" />
    <Page Include="..\theme-preview\ThemeWindow.xaml" Link="ThemeWindow.xaml" />
    <Compile Include="..\theme-preview\ThemeWindow.xaml.cs" Link="ThemeWindow.xaml.cs" />
    <Resource Include="..\theme-preview\Assets\*.jpg" Link="Assets\%(Filename)%(Extension)" />
    <Compile Include="..\..\src\SynthwaveNowPlaying\Visuals\SpectrumView.cs" Link="SpectrumView.cs" />
    <Compile Include="..\..\src\SynthwaveNowPlaying\Classic\ArchivedVisualizer.cs" Link="ArchivedVisualizer.cs" />
    <Compile Include="..\..\src\SynthwaveNowPlaying\Settings\SpectrumLab.xaml.cs" Link="SpectrumLab.cs" />
    <EmbeddedResource Include="..\..\src\SynthwaveNowPlaying\Settings\SpectrumLab.xaml" LogicalName="Settings.SpectrumLab.xaml" />
    <EmbeddedResource Include="Assets\*.mp3" LogicalName="WavePlayerSetup.Assets.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Assets\spectrum-demo.bin" LogicalName="WavePlayerSetup.Assets.spectrum-demo.bin" />
    <EmbeddedResource Include="..\..\src\SynthwaveNowPlaying\Classic\SynthwaveNowPlaying.dll" LogicalName="Setup.Classic.dll" />
    <EmbeddedResource Include="..\intermediate\payload.zip" LogicalName="WavePlayerSetup.payload.zip" />
  </ItemGroup>
</Project>



