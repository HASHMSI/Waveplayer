<Window x:Class="WaveplayerSetup.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Waveplayer Setup" Width="820" Height="650"
 Icon="Assets/Waveplayer.ico" MinWidth="820" MinHeight="650" MaxWidth="820" MaxHeight="650" WindowStyle="None"
 AllowsTransparency="True" Background="Transparent" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <DrawingBrush x:Key="Lines" Viewport="0,0,38,38" ViewportUnits="Absolute" TileMode="Tile">
   <DrawingBrush.Drawing><GeometryDrawing Geometry="M0,0 L38,0 M0,0 L0,38">
    <GeometryDrawing.Pen><Pen Brush="#2147BCED" Thickness=".8"/></GeometryDrawing.Pen>
   </GeometryDrawing></DrawingBrush.Drawing>
  </DrawingBrush>
 </Window.Resources>
 <Border x:Name="WindowFrame" CornerRadius="17" BorderBrush="#B95FDB" BorderThickness="1" ClipToBounds="True">
  <Grid>
   <Grid.Background><LinearGradientBrush EndPoint="1,1"><GradientStop Color="#151027"/><GradientStop Color="#0C1429" Offset=".6"/><GradientStop Color="#1D1230" Offset="1"/></LinearGradientBrush></Grid.Background>
   <Grid Opacity=".35" Background="{StaticResource Lines}" IsHitTestVisible="False"/>
   <Ellipse Width="510" Height="510" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-265,-150,0" IsHitTestVisible="False">
    <Ellipse.Fill><RadialGradientBrush><GradientStop Color="#6FEC4FBA"/><GradientStop Color="#003A203B" Offset="1"/></RadialGradientBrush></Ellipse.Fill>
   </Ellipse>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/><RowDefinition Height="76"/></Grid.RowDefinitions>
    <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
    <Border Grid.Row="0" Grid.ColumnSpan="2" BorderBrush="#52507196" BorderThickness="0,0,0,1" Background="#B5101020"
            MouseLeftButtonDown="Header_Drag">
     <DockPanel Margin="19,0,13,0">
      <Button DockPanel.Dock="Right" Content="×" Click="Close_Click" Width="32" Height="30" Padding="0" Margin="10,0,0,0"/>
      <TextBlock Text="●  WAVEPLAYER" FontSize="11" FontWeight="Bold" Foreground="#FF70DEFF" VerticalAlignment="Center"/>
      <TextBlock Text="  /  SETUP EXPERIENCE" FontSize="9" Foreground="#B7A9CD" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
    <Border Grid.Row="1" Background="#9B111226" BorderBrush="#4A4261" BorderThickness="0,0,1,0">
     <Grid Margin="20,24,15,20">
      <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <StackPanel><TextBlock Text="YOUR LISTENING SPACE" Foreground="#FB72D1" FontSize="9" FontWeight="Bold"/>
       <TextBlock Text="WAVE&#10;PLAYER" FontSize="33" FontWeight="Black" LineHeight="32" Margin="0,9,0,2"/>
       <TextBlock Text="Stereo FM 84" FontSize="11" Foreground="#74DDF8"/></StackPanel>
      <StackPanel x:Name="Steps" Grid.Row="1" Margin="0,50,0,0"/>
     </Grid>
    </Border>
    <Grid Grid.Row="1" Grid.Column="1" Margin="34,27,34,16">
     <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
     <TextBlock x:Name="Eyebrow" Foreground="#6DDFF8" FontSize="10" FontWeight="Bold"/>
     <TextBlock x:Name="Heading" Grid.Row="1" FontSize="30" FontWeight="Bold" Margin="0,9,0,16"/>
     <ScrollViewer x:Name="PageScroll" Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" CanContentScroll="False">
      <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource SetupScrollBar}"/></ScrollViewer.Resources>
      <ContentControl x:Name="PageHost"/>
     </ScrollViewer>
    </Grid>
    <Border Grid.Row="2" Grid.ColumnSpan="2" Background="#D40F1125" BorderBrush="#52507196" BorderThickness="0,1,0,0">
     <Grid Margin="20,13"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <StackPanel VerticalAlignment="Center"><TextBlock x:Name="StepCounter" Foreground="#FF76D8" FontSize="10" FontWeight="Bold"/>
       <TextBlock x:Name="FooterNote" Foreground="#B7A9CD" FontSize="9" Margin="0,3,0,0"/></StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal">
       <Button x:Name="BackButton" Content="BACK" Click="Back_Click" Margin="0,0,9,0" Width="90"/>
       <Button x:Name="NextButton" Content="NEXT  →" Click="Next_Click" Width="130" Background="#783278" BorderBrush="#FF77D5"/>
      </StackPanel>
     </Grid>
    </Border>
   </Grid>
  </Grid>
 </Border>
</Window>
