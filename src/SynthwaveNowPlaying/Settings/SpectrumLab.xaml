<Grid
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid.Resources>
        <DrawingBrush x:Key="ScopeGrid" Viewport="0,0,30,16" ViewportUnits="Absolute"
                      Viewbox="0,0,30,16" ViewboxUnits="Absolute" TileMode="Tile">
            <DrawingBrush.Drawing>
                <GeometryDrawing Geometry="M 0,16 L 0,0 30,0">
                    <GeometryDrawing.Pen><Pen Brush="#294B5277" Thickness="1"/></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingBrush.Drawing>
        </DrawingBrush>
        <Style x:Key="PreviewCard" TargetType="RadioButton">
            <Setter Property="GroupName" Value="VisualizerVersion"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Frame" CornerRadius="10" BorderBrush="#544269" BorderThickness="1" Padding="11,7">
                            <Border.Background>
                                <LinearGradientBrush EndPoint="1,1">
                                    <GradientStop Color="#292038"/><GradientStop Color="#151624" Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>
                            <StackPanel>
                                <Grid Margin="1,0,1,5">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse x:Name="Indicator" Width="9" Height="9" Stroke="{TemplateBinding Foreground}" Margin="0,0,7,0"/>
                                        <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(AutomationProperties.Name)}"
                                                   FontSize="16" FontWeight="SemiBold" Foreground="#FFF5FB"/>
                                    </StackPanel>
                                    <TextBlock Text="{TemplateBinding Tag}" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               FontSize="11" Foreground="{TemplateBinding Foreground}" FontFamily="Consolas"/>
                                </Grid>
                                <Border CornerRadius="6" Padding="5,0" Background="#111122">
                                    <Grid Height="62" Background="{StaticResource ScopeGrid}" ClipToBounds="True" IsHitTestVisible="False">
                                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ToolTip}" FontSize="10"
                                           Foreground="#DECEE7" Margin="1,5,1,0" TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#A785C1"/></Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                                <Setter TargetName="Indicator" Property="Fill" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"/>
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="White"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Grid.Resources>
    <StackPanel>
        <DockPanel Margin="1,0,1,8">
            <TextBlock x:Name="SourceText" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#7CD9E5"
                       FontSize="9" FontWeight="Bold" Text="DEMO LOOP"/>
            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#F7F1FF" Text="Live comparison"/>
        </DockPanel>
        <RadioButton x:Name="Pulse" Style="{StaticResource PreviewCard}" AutomationProperties.Name="Pulse" Tag="20 ms"
                     ToolTip="Original response. Bars jump to each peak." Foreground="#FF88D1"/>
        <RadioButton x:Name="Glide" Style="{StaticResource PreviewCard}" AutomationProperties.Name="Glide" Tag="16 ms"
                     ToolTip="Smoothed response. Bars ease into and out of each peak." Foreground="#72DFEC"/>
    </StackPanel>
</Grid>
