<UserControl x:Class="SynthwaveNowPlaying.UI.RadioConceptView"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:local="clr-namespace:SynthwaveNowPlaying.UI" FontFamily="Bahnschrift">
 <UserControl.Resources>
  <Style x:Key="ConceptSeek" TargetType="Slider">
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider">
    <Grid Background="Transparent" Height="18">
     <Border Height="2.5" CornerRadius="2" Background="#4A9295B4" VerticalAlignment="Center"/>
     <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" IsDirectionReversed="False">
      <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate><Border Height="2.5" CornerRadius="2" VerticalAlignment="Center"><Border.Background><LinearGradientBrush><GradientStop Color="#94E7DF"/><GradientStop Color="#CFABED" Offset="1"/></LinearGradientBrush></Border.Background></Border></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
      <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Opacity="0" Focusable="False"/></Track.IncreaseRepeatButton>
      <Track.Thumb><Thumb Width="9" Height="12" Cursor="Hand"><Thumb.Template><ControlTemplate><Grid><Ellipse Width="9" Height="9" Fill="#386EDDD1"/><Ellipse Width="5" Height="5" Fill="#F5EFFF" Stroke="#97EBDD" StrokeThickness="1"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
     </Track>
    </Grid>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EDE7FF"/><Setter Property="Background" Value="#40262349"/>
   <Setter Property="BorderBrush" Value="#556D729D"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="0.6" CornerRadius="5" RenderTransformOrigin=".5,.5">
     <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
    </Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#8DE9DF"/>
      <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.035" Duration="0:0:.15"/><DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.035" Duration="0:0:.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
      <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:.2"/><DoubleAnimation Storyboard.TargetName="Frame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:.2"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
     </Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX=".95" ScaleY=".95"/></Setter.Value></Setter></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
 </UserControl.Resources>
 <Border CornerRadius="10" BorderThickness=".7" BorderBrush="#777E87B8" Background="#FF101329" Padding="1">
  <Grid x:Name="ConsoleSurface" ClipToBounds="True" SizeChanged="ConsoleSurface_SizeChanged">
   <Grid.RowDefinitions><RowDefinition Height="23"/><RowDefinition Height="*"/><RowDefinition Height="27"/></Grid.RowDefinitions>
   <local:LoopVideoView x:Name="RoadVideo" Grid.RowSpan="3" IsHitTestVisible="False" Opacity="0"/>
   <Border x:Name="VideoPaletteTint" Grid.RowSpan="3" IsHitTestVisible="False" Opacity=".34">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop x:Name="VideoPrimary" Color="#B54D3059" Offset="0"/><GradientStop x:Name="VideoSecondary" Color="#A5252D52" Offset="1"/></LinearGradientBrush></Border.Background>
   </Border>
   <Border Grid.RowSpan="3" IsHitTestVisible="False">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#B510112B" Offset="0"/><GradientStop Color="#6910112B" Offset=".42"/><GradientStop Color="#A510112B" Offset="1"/></LinearGradientBrush></Border.Background>
   </Border>
   <Border Grid.Row="0" BorderBrush="#426A668F" BorderThickness="0,0,0,.5" Background="#A5242344"/>
   <Grid Margin="9,0,8,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <Button Width="12" Height="14" Background="Transparent" BorderBrush="Transparent" Click="Local_Click" ToolTip="Return to local music" AutomationProperties.Name="Return to local music"><Ellipse Width="5" Height="5" Fill="#FF999C"/></Button>
     <TextBlock Text="≈" Foreground="#94E7D9" FontSize="16" Margin="4,-2,5,0"/>
     <TextBlock Text="WAVEPLAYER" Foreground="#F2EAFF" FontSize="8" FontWeight="Bold" VerticalAlignment="Center"/>
     <TextBlock x:Name="ModeLabel" Text=" / RADIO" Foreground="#AFA8CD" FontSize="6.5" VerticalAlignment="Center"/>
    </StackPanel>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
     <Button x:Name="Eq" Visibility="Collapsed" Width="22" Height="17" Margin="0,0,4,0" Click="Eq_Click" ToolTip="Edit EQ"><TextBlock Text="EQ" FontSize="6" FontWeight="Bold"/></Button>
     <Button x:Name="EqReset" Visibility="Collapsed" Width="18" Height="17" Margin="0,0,4,0" Click="EqReset_Click" ToolTip="Reset EQ"><Path Data="M10,4 A4,4 0 1 0 10,9 M10,4 L10,1 M10,4 L7,4" Stroke="#CDE8EB" StrokeThickness="1" Width="10" Height="10" Stretch="Uniform"/></Button>
     <Button x:Name="Remix" Visibility="Collapsed" Width="37" Height="17" Margin="0,0,4,0" Click="Remix_Click" ToolTip="Toggle Automix"><TextBlock x:Name="RemixLabel" Text="REMIX" FontSize="6" FontWeight="Bold"/></Button>
     <Button x:Name="PinControl" Width="21" Height="17" Margin="0,0,4,0" Click="Pin_Click" ToolTip="Pin or unlock widget">
      <Path x:Name="PinGlyph" Data="M10,1 L15,6 12,7 9,11 7,9 2,15 1,14 6,8 4,6 8,3 Z" Stroke="#E9E1FF" StrokeThickness="1.15" StrokeLineJoin="Round" Width="12" Height="12" Stretch="Uniform"/>
     </Button>
     <Button Width="21" Height="17" Margin="0,0,4,0" Click="Settings_Click" ToolTip="Settings" AutomationProperties.Name="Settings">
      <Grid Width="13" Height="13">
       <Path Data="M5,1 L8,1 8.5,3 10,3.5 12,3 13,5.5 11.5,7 11.5,8 13,9.5 11.5,12 9.5,11.5 8,12.5 7.5,14 4.5,14 4,12 2.5,11.5 .5,12 -1,9.5 .5,8 .5,6.5 -1,5 0.5,2.5 2.5,3 4,2.5 Z" Stretch="Uniform" Stroke="#E9E1FF" StrokeThickness="1" StrokeLineJoin="Round"/>
       <Ellipse Width="4" Height="4" Stroke="#E9E1FF" StrokeThickness="1"/>
      </Grid>
     </Button>
     <Button Width="21" Height="17" Click="Close_Click" ToolTip="Hide widget"><Path Data="M2,2 L12,12 M12,2 L2,12" Stroke="#E9E1FF" StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="10" Height="10" Stretch="Uniform"/></Button>
    </StackPanel>
   </Grid>
   <Grid Grid.Row="1" x:Name="Hero">
    <local:RadioScenery x:Name="Scenery"/>
    <Grid x:Name="CoverHost" Width="78" Height="78" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="9,0,0,0" Visibility="Collapsed"/>
    <Grid x:Name="SpectrumHost" Margin="2,0"/>
    <StackPanel x:Name="MetadataPanel" Margin="13,5,70,0" VerticalAlignment="Top" IsHitTestVisible="False">
     <TextBlock x:Name="NowLabel" Text="NOW ON AIR" Foreground="#FFA7AE" FontSize="5.5" FontWeight="Bold"/>
     <TextBlock x:Name="Station" Text="CHILLSYNTH" Foreground="#F5EFFF" FontSize="16" FontWeight="Bold" FontStyle="Italic" Margin="0,1,0,0" TextTrimming="CharacterEllipsis"/>
     <TextBlock x:Name="Metadata" Text="Connecting to Nightride FM…" Foreground="#D6D4EB" FontSize="7" TextTrimming="CharacterEllipsis"/>
    </StackPanel>
    <StackPanel x:Name="LiveBadge" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,8,11,0" IsHitTestVisible="False">
     <Border BorderBrush="#DFFF9AA8" BorderThickness=".7" CornerRadius="6" Padding="5,2"><TextBlock x:Name="Status" Text="TUNING" Foreground="#FFB1BD" FontSize="6" FontWeight="Bold"/></Border>
    </StackPanel>
   </Grid>
   <Border Grid.Row="2" Background="#BB232241" BorderBrush="#557C709E" BorderThickness="0,.5,0,0"/>
   <Grid Grid.Row="2" Margin="10,0">
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
     <local:ShuffleControl x:Name="Shuffle" Width="24" Height="23" Margin="0,0,3,0" Click="Shuffle_Click"/>
     <Button Width="24" Height="19" Click="Previous_Click" ToolTip="Previous channel" Background="Transparent" BorderBrush="Transparent"><Path Data="M2,1 L4,1 4,11 2,11 Z M12,1 L12,11 5,6 Z" Fill="#E4E2FF" Width="11" Height="10" Stretch="Uniform"/></Button>
     <Button Width="31" Height="21" Margin="3,0" BorderBrush="#8CE9DF" Click="Play_Click" ToolTip="Play or pause radio" AutomationProperties.Name="Play or pause radio"><TextBlock x:Name="PlayGlyph" Text="▶" FontSize="11"/></Button>
     <Button Width="24" Height="19" Click="Next_Click" ToolTip="Next channel" Background="Transparent" BorderBrush="Transparent"><Path Data="M10,1 L12,1 12,11 10,11 Z M2,1 L9,6 2,11 Z" Fill="#E4E2FF" Width="11" Height="10" Stretch="Uniform"/></Button>
     <Border x:Name="FormatDivider" Width=".6" Height="12" Background="#645D648E" Margin="9,0"/>
     <TextBlock x:Name="Format" Text="NIGHTRIDE.FM" FontSize="6" Foreground="#BBB8D6" VerticalAlignment="Center"/>
     <Border x:Name="StatusDivider" Width=".6" Height="12" Background="#645D648E" Margin="9,0"/>
     <TextBlock x:Name="FooterStatus" Text="CONNECTING" Foreground="#FF9DAB" FontSize="6.5" FontWeight="Bold" VerticalAlignment="Center"/>
    </StackPanel>
    <Grid x:Name="SeekHost" Margin="130,0,0,0" Visibility="Collapsed" VerticalAlignment="Center">
     <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="35"/></Grid.ColumnDefinitions>
     <Grid x:Name="SeekSliderHost"/>
     <TextBlock x:Name="Elapsed" Grid.Column="1" Text="0:00" FontSize="7" Foreground="#D7D5EB" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </Grid>
    <Button x:Name="Favorite" HorizontalAlignment="Right" VerticalAlignment="Center" Width="25" Height="20" Content="♡" FontSize="16" Foreground="#FF9DAB" BorderBrush="Transparent" Background="Transparent" FocusVisualStyle="{x:Null}" Click="Favorite_Click" ToolTip="Favorite channel">
     <Button.Template><ControlTemplate TargetType="Button">
      <Grid Background="Transparent">
       <Ellipse x:Name="HeartRing" Width="16" Height="16" Stroke="#FFACBD" StrokeThickness=".8" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin=".5,.5"><Ellipse.RenderTransform><ScaleTransform/></Ellipse.RenderTransform></Ellipse>
       <Grid x:Name="HeartPulse" RenderTransformOrigin=".5,.5"><Grid.RenderTransform><ScaleTransform/></Grid.RenderTransform>
        <ContentPresenter x:Name="Heart" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5"><ContentPresenter.RenderTransform><ScaleTransform/></ContentPresenter.RenderTransform></ContentPresenter>
       </Grid>
      </Grid>
      <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True">
       <Setter Property="Foreground" Value="#FFD0DA"/>
       <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Heart" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.12" Duration="0:0:.15"/><DoubleAnimation Storyboard.TargetName="Heart" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.12" Duration="0:0:.15"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
       <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="Heart" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:.18"/><DoubleAnimation Storyboard.TargetName="Heart" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
      </Trigger></ControlTemplate.Triggers>
     </ControlTemplate></Button.Template>
    </Button>
   </Grid>
  </Grid>
 </Border>
</UserControl>
