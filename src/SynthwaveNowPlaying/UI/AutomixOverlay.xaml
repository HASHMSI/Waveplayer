<Window x:Class="SynthwaveNowPlaying.AutomixOverlay"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Waveplayer · Automix Beta" Width="280" Height="132" WindowStyle="None"
 AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
 ShowActivated="False" ShowInTaskbar="False" Topmost="True" Focusable="False"
 UseLayoutRounding="True">
 <Grid Margin="5" IsHitTestVisible="False" RenderTransformOrigin=".5,.5">
  <Grid.RenderTransform><TranslateTransform x:Name="Slide"/></Grid.RenderTransform>
  <Border CornerRadius="11" Background="#FA0C0D19" BorderThickness="1" Padding="1">
   <Border.BorderBrush><LinearGradientBrush><GradientStop Color="#FFEE67C7"/><GradientStop Color="#FF62D9F2" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
   <Grid x:Name="ClippedSurface" SizeChanged="Surface_SizeChanged">
    <Grid.RowDefinitions><RowDefinition Height="21"/><RowDefinition Height="*"/><RowDefinition Height="16"/></Grid.RowDefinitions>
    <Grid Margin="9,0">
     <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
      <Image Source="/Waveplayer;component/Assets/Waveplayer.ico" Width="11" Height="11" Margin="0,0,4,0"/>
      <TextBlock Text="WAVEPLAYER" Foreground="#FFF1E9FF" FontSize="7" FontWeight="Bold"/>
     </StackPanel>
     <TextBlock x:Name="HeaderState" Text="AUTOMIX · BETA" Foreground="#FF85DDF5" FontSize="6" HorizontalAlignment="Right" VerticalAlignment="Center"/>
    </Grid>
    <Grid Grid.Row="1">
     <Grid x:Name="MixView">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Grid Background="#FF232145" ClipToBounds="True">
       <Image x:Name="OldBackdrop" Stretch="UniformToFill" Margin="-10"><Image.Effect><BlurEffect Radius="9"/></Image.Effect><Image.CacheMode><BitmapCache/></Image.CacheMode></Image>
       <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#46101429"/><GradientStop Color="#C0101329" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
       <StackPanel VerticalAlignment="Center" Margin="8,0,18,0">
        <TextBlock Text="NOW PLAYING" FontSize="5.5" Foreground="#FF9FE1F5" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Width="25" Height="31" HorizontalAlignment="Left" CornerRadius="4" BorderBrush="#FF946FA2" BorderThickness=".7" Background="#663E3063"><Image x:Name="OldCover" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,24,30" RadiusX="3" RadiusY="3"/></Image.Clip></Image></Border>
         <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="OldTitle" Text="Acedia" FontSize="11" Foreground="#FFFFFFFF" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="OldArtist" Text="Artist" FontSize="7" Foreground="#FFDDD6EC" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
         </StackPanel>
        </Grid>
       </StackPanel>
      </Grid>
      <Grid Grid.Column="1" Background="#FF42203E" ClipToBounds="True">
       <Image x:Name="NewBackdrop" Stretch="UniformToFill" Margin="-10"><Image.Effect><BlurEffect Radius="9"/></Image.Effect><Image.CacheMode><BitmapCache/></Image.CacheMode></Image>
       <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#46361639"/><GradientStop Color="#C024102B" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
       <StackPanel VerticalAlignment="Center" Margin="21,0,7,0">
        <TextBlock Text="UP NEXT" FontSize="5.5" Foreground="#FFFFA4D9" FontWeight="SemiBold" Margin="0,0,0,5"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26"/><ColumnDefinition/></Grid.ColumnDefinitions>
         <Border Width="25" Height="31" HorizontalAlignment="Left" CornerRadius="4" BorderBrush="#FFCE87BD" BorderThickness=".7" Background="#665C2E53"><Image x:Name="NewCover" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,24,30" RadiusX="3" RadiusY="3"/></Image.Clip></Image></Border>
         <StackPanel Grid.Column="1" Margin="5,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="NewTitle" Text="Heartline" FontSize="11" Foreground="#FFFFFFFF" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
          <TextBlock x:Name="NewArtist" Text="Artist" FontSize="7" Foreground="#FFE5C6DC" TextTrimming="CharacterEllipsis" Margin="0,3,0,0"/>
         </StackPanel>
        </Grid>
       </StackPanel>
      </Grid>
      <Rectangle Grid.ColumnSpan="2" Width=".6" Fill="#338FCBEF" HorizontalAlignment="Center"/>
      <Image Grid.ColumnSpan="2" Width="43" Height="43" HorizontalAlignment="Center" VerticalAlignment="Center" RenderTransformOrigin=".5,.5">
       <Image.Source><BitmapImage UriSource="/Waveplayer;component/Assets/AutomixDisc.png" DecodePixelWidth="128"/></Image.Source>
       <Image.RenderTransform><RotateTransform x:Name="DiscRotation"/></Image.RenderTransform>
      </Image>
     </Grid>
     <Grid x:Name="CompleteView" Visibility="Collapsed" Opacity="0" Background="#FF32203E" ClipToBounds="True">
      <Image x:Name="CompleteBackdrop" Stretch="UniformToFill" Margin="-14"><Image.Effect><BlurEffect Radius="12"/></Image.Effect><Image.CacheMode><BitmapCache/></Image.CacheMode></Image>
      <Rectangle Fill="#B0151027"/>
      <Border Width="41" Height="41" HorizontalAlignment="Left" Margin="10,0,0,0" CornerRadius="5" ClipToBounds="True" BorderBrush="#FFDD85CA" BorderThickness="1"><Image x:Name="CompleteCover" Stretch="UniformToFill"><Image.Clip><RectangleGeometry Rect="0,0,39,39" RadiusX="4" RadiusY="4"/></Image.Clip></Image></Border>
      <StackPanel Margin="61,0,10,0" VerticalAlignment="Center">
       <TextBlock Text="NOW PLAYING" FontSize="6" Foreground="#FF9CDFF3" Margin="0,0,0,3"/>
       <TextBlock x:Name="CompleteTitle" Text="Heartline" Foreground="White" FontSize="13" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
       <TextBlock x:Name="CompleteArtist" Foreground="#FFE5C6DC" FontSize="8" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/>
      </StackPanel>
     </Grid>
    </Grid>
    <Grid Grid.Row="2" Margin="9,0,9,0">
     <Border Height="2" Background="#FF343047" CornerRadius="1" VerticalAlignment="Top" Margin="0,3,0,0"/>
     <Border x:Name="ProgressFill" Height="2" Width="0" CornerRadius="1" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="0,3,0,0">
      <Border.Background><LinearGradientBrush><GradientStop Color="#FFFF71CA"/><GradientStop Color="#FF71E5F7" Offset="1"/></LinearGradientBrush></Border.Background>
     </Border>
     <TextBlock x:Name="MixStatus" Text="MIXING" FontSize="5.5" Foreground="#FFD0C8DF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,1"/>
    </Grid>
   </Grid>
  </Border>
 </Grid>
</Window>
