<Window x:Class="SynthwaveNowPlaying.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:po="http://schemas.microsoft.com/winfx/2006/xaml/presentation/options"
        xmlns:local="clr-namespace:SynthwaveNowPlaying"
        Title="Waveplayer · Now Playing" Width="410" Height="153" MinWidth="390" MinHeight="146"
        Icon="Assets/Waveplayer.ico" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResizeWithGrip" Topmost="True" ShowInTaskbar="True"
        WindowStartupLocation="Manual" UseLayoutRounding="True" SnapsToDevicePixels="True" FontFamily="Bahnschrift">
    <Window.Resources>
        <SolidColorBrush x:Key="Ink" Color="#FFF7F1FF" />
        <SolidColorBrush x:Key="Muted" Color="#FFB7AFCB" />
        <SolidColorBrush x:Key="AlbumPrimaryBrush" po:Freeze="False" Color="#FFFF3EBD" />
        <SolidColorBrush x:Key="AlbumSecondaryBrush" po:Freeze="False" Color="#FF3DDCFF" />
        <Style x:Key="NeonButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFFFDDF7"/><Setter Property="Background" Value="#38251840"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AlbumSecondaryBrush}"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,5"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="B" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                </Border><ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="B" Property="Background" Value="#74351F62"/><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource AlbumPrimaryBrush}"/>
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="B" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.06" Duration="0:0:0.13"/>
                            <DoubleAnimation Storyboard.TargetName="B" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.06" Duration="0:0:0.13"/>
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="B" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.13"/>
                            <DoubleAnimation Storyboard.TargetName="B" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.13"/>
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="WidgetControlButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF9F2FF"/>
            <Setter Property="Background" Value="#D91D1A35"/>
            <Setter Property="BorderBrush" Value="#826A709D"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="Frame" CornerRadius="8" Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                        RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                    <Grid>
                        <Border x:Name="ActiveWash" Background="{DynamicResource AlbumPrimaryBrush}" CornerRadius="7" Opacity="0.04"/>
                        <Border x:Name="HoverLine" Height="1" Margin="4,2,4,0" VerticalAlignment="Top" Background="{DynamicResource AlbumSecondaryBrush}" CornerRadius="1" Opacity="0"/>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="Tag" Value="Active">
                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AlbumPrimaryBrush}"/>
                        <Setter TargetName="ActiveWash" Property="Opacity" Value="0.28"/>
                    </Trigger>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="Frame" Property="Background" Value="#FF2D2949"/>
                        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AlbumSecondaryBrush}"/>
                        <Setter TargetName="ActiveWash" Property="Opacity" Value="0.2"/>
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLine" Storyboard.TargetProperty="Opacity" To="0.85" Duration="0:0:0.18"/>
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="HoverLine" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/>
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True">
                        <Setter TargetName="ActiveWash" Property="Opacity" Value="0.36"/>
                        <Setter TargetName="Frame" Property="RenderTransform"><Setter.Value><ScaleTransform ScaleX="0.96" ScaleY="0.96"/></Setter.Value></Setter>
                    </Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="#FFFFFFFF"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.4"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="HeaderControlButton" TargetType="Button" BasedOn="{StaticResource WidgetControlButton}">
            <Setter Property="Background" Value="#A9151A31"/>
            <Setter Property="BorderBrush" Value="#655B668E"/>
        </Style>
        <Style x:Key="RemixControlButton" TargetType="Button" BasedOn="{StaticResource WidgetControlButton}">
            <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#E8492A60"/><GradientStop Color="#D825365B" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource AlbumPrimaryBrush}"/>
        </Style>
        <Style x:Key="TransportControlButton" TargetType="Button" BasedOn="{StaticResource WidgetControlButton}">
            <Setter Property="Background" Value="#E3191E39"/>
            <Setter Property="BorderBrush" Value="#A07182B3"/>
        </Style>
        <Style x:Key="PrimaryControlButton" TargetType="Button" BasedOn="{StaticResource WidgetControlButton}">
            <Setter Property="Background"><Setter.Value><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#F55B3271"/><GradientStop Color="#E52A315C" Offset="1"/></LinearGradientBrush></Setter.Value></Setter>
            <Setter Property="BorderBrush" Value="{DynamicResource AlbumPrimaryBrush}"/>
        </Style>
        <Style x:Key="CloseControlButton" TargetType="Button" BasedOn="{StaticResource WidgetControlButton}">
            <Setter Property="Background" Value="#CF311C35"/>
            <Setter Property="BorderBrush" Value="#C38E8299"/>
        </Style>
        <Style x:Key="NeonCombo" TargetType="ComboBox">
            <Setter Property="Foreground" Value="#FFF7ECFF"/><Setter Property="Background" Value="#FF17102C"/><Setter Property="BorderBrush" Value="#995F4BD2"/><Setter Property="Padding" Value="9,6"/>
            <Setter Property="ItemContainerStyle"><Setter.Value><Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#FFF7ECFF"/><Setter Property="Background" Value="#FF17102C"/><Setter Property="Padding" Value="9,7"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="ItemBorder" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="Background" Value="#FF652A83"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style></Setter.Value></Setter>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" Focusable="False"><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="28"/></Grid.ColumnDefinitions><ContentPresenter Margin="9,5" VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"/><TextBlock Grid.Column="1" Text="⌄" Foreground="#FFFF78D7" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></ToggleButton><Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade"><Border Background="#FF17102C" BorderBrush="#FFB943D6" BorderThickness="1" CornerRadius="8"><ScrollViewer MaxHeight="260"><ItemsPresenter/></ScrollViewer></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlaylistTrackButton" TargetType="Button">
            <Setter Property="Foreground" Value="#FFF7ECFF"/><Setter Property="Background" Value="#28171030"/>
            <Setter Property="BorderBrush" Value="Transparent"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="5,3"/><Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="RowFrame" CornerRadius="6" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform/></Border.RenderTransform>
                    <ContentPresenter Margin="{TemplateBinding Padding}" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter TargetName="RowFrame" Property="Background" Value="#805D2D7C"/><Setter TargetName="RowFrame" Property="BorderBrush" Value="{DynamicResource AlbumPrimaryBrush}"/>
                        <Trigger.EnterActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RowFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.015" Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetName="RowFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.015" Duration="0:0:0.12"/>
                        </Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard>
                            <DoubleAnimation Storyboard.TargetName="RowFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.12"/>
                            <DoubleAnimation Storyboard.TargetName="RowFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.12"/>
                        </Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsPressed" Value="True"><Setter TargetName="RowFrame" Property="Background" Value="#A34E247A"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="PlaylistListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,2"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter>
            <Style.Triggers><DataTrigger Binding="{Binding IsDragging}" Value="True"><Setter Property="Opacity" Value=".23"/></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="PlaylistActionButton" TargetType="Button">
            <Setter Property="Width" Value="19"/><Setter Property="Height" Value="24"/>
            <Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="1,0"/>
            <Setter Property="Background" Value="#3B38234E"/><Setter Property="BorderBrush" Value="#765D4784"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="Foreground" Value="#FFE9C6F7"/>
            <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="10"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ActionFrame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="5" RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform><ScaleTransform ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ActionFrame" Property="Background" Value="#A05C2F79"/><Setter TargetName="ActionFrame" Property="BorderBrush" Value="{DynamicResource AlbumPrimaryBrush}"/>
                        <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ActionFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1.12" Duration="0:0:0.14"/><DoubleAnimation Storyboard.TargetName="ActionFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1.12" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.EnterActions>
                        <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ActionFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleX)" To="1" Duration="0:0:0.14"/><DoubleAnimation Storyboard.TargetName="ActionFrame" Storyboard.TargetProperty="(UIElement.RenderTransform).(ScaleTransform.ScaleY)" To="1" Duration="0:0:0.14"/></Storyboard></BeginStoryboard></Trigger.ExitActions>
                    </Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter TargetName="ActionFrame" Property="Opacity" Value="0.3"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="PlaylistTrackTemplate">
            <Grid x:Name="SongRow" Height="44">
            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <Button x:Name="TrackRow" Grid.Column="0" Style="{StaticResource PlaylistTrackButton}" Tag="{Binding}" Click="PlaylistTrackButton_Click" Height="44">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="19"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <Border Width="34" Height="34" CornerRadius="6" BorderThickness="1" BorderBrush="#CCFF73D3" Background="#FF25123D" VerticalAlignment="Center">
                        <Grid ClipToBounds="True">
                            <Grid.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#FF171957"/><GradientStop Color="#FFD42B9B" Offset="0.62"/><GradientStop Color="#FFFFAD72" Offset="1"/></LinearGradientBrush></Grid.Background>
                            <Ellipse Width="21" Height="21" Fill="#FFFFAD72" Opacity=".78" VerticalAlignment="Top" Margin="0,2,0,0"/>
                            <Image Source="{Binding Artwork}" Stretch="UniformToFill"/>
                            <Border Height="5" VerticalAlignment="Bottom" Background="#664B1B74"/>
                        </Grid>
                    </Border>
                    <TextBlock x:Name="TrackMarker" Grid.Column="1" Text="▶" FontSize="8" Foreground="{DynamicResource AlbumPrimaryBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                    <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="4,0,5,0">
                        <TextBlock Text="{Binding Title}" FontSize="9.5" FontWeight="Bold" Foreground="#FFF8ECFF" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding Artist}" FontSize="7.5" Foreground="#FFE3A5E4" Margin="0,2,0,0" TextTrimming="CharacterEllipsis"/>
                    </StackPanel>
                    <Border Grid.Column="3" CornerRadius="7" BorderBrush="{DynamicResource AlbumSecondaryBrush}" Opacity="0.82" BorderThickness="1" Background="#3A152647" Padding="6,3" VerticalAlignment="Center" Margin="4,0,2,0">
                        <TextBlock Text="{Binding DurationText}" FontSize="8" FontWeight="SemiBold" Foreground="#FFD5E6FF"/>
                    </Border>
                </Grid>
            </Button>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="3,0,1,0">
                <Button Style="{StaticResource PlaylistActionButton}" Tag="{Binding}" Width="26" Cursor="SizeNS"
                        PreviewMouseLeftButtonDown="SortGrip_Down" ToolTip="Drag to reorder" AutomationProperties.Name="Drag to reorder">
                    <Path Data="M1,2 H13 M1,6 H13 M1,10 H13" Stroke="{DynamicResource AlbumSecondaryBrush}" StrokeThickness="1.6"/>
                </Button>
                <Button Style="{StaticResource PlaylistActionButton}" Tag="{Binding}" Click="PlaylistRemove_Click" ToolTip="Remove from this list only">
                    <Path Data="M2,4 H14 M5,4 V2 H11 V4 M4,5 L5,14 H11 L12,5 M7,7 V12 M9,7 V12" Stroke="{DynamicResource AlbumPrimaryBrush}" StrokeThickness="1.2" Width="12" Height="12" Stretch="Uniform"/>
                </Button>
            </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="TrackRow" Property="Background" Value="#A0441D68"/><Setter TargetName="TrackRow" Property="BorderBrush" Value="{DynamicResource AlbumPrimaryBrush}"/>
                    <Setter TargetName="TrackMarker" Property="Visibility" Value="Visible"/>
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <Style x:Key="NeonScrollBar" TargetType="ScrollBar">
            <Setter Property="Width" Value="12"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Grid Width="12" Background="Transparent">
                    <Border Width="4" CornerRadius="2" Background="#FF241B35" HorizontalAlignment="Center" Margin="0,3"/>
                    <Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" Minimum="{TemplateBinding Minimum}"
                           Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" ViewportSize="{TemplateBinding ViewportSize}"
                           IsDirectionReversed="True">
                        <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" IsTabStop="False" Opacity="0"/></Track.DecreaseRepeatButton>
                        <Track.Thumb><Thumb MinHeight="30" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb">
                    <Border x:Name="ThumbGlow" Margin="2,0" CornerRadius="4" Background="#FF8E46C8" BorderBrush="{DynamicResource AlbumPrimaryBrush}" BorderThickness="1">
                                <Border.Effect><DropShadowEffect Color="#FFFF4FD0" BlurRadius="7" ShadowDepth="0" Opacity="0.55"/></Border.Effect>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbGlow" Property="Background" Value="#FFD65CCB"/></Trigger>
                                <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbGlow" Property="Background" Value="#FFFF8BE0"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                        <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" IsTabStop="False" Opacity="0"/></Track.IncreaseRepeatButton>
                    </Track>
                </Grid>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="NeonSeekBar" TargetType="Slider">
            <Setter Property="Foreground" Value="#FFFF54C8"/><Setter Property="Background" Value="#66352A53"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="16" VerticalAlignment="Center">
                <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{TemplateBinding Value}" Orientation="Horizontal" IsDirectionReversed="False">
                    <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="4" CornerRadius="3" Background="{DynamicResource AlbumPrimaryBrush}" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="3" CornerRadius="3" Background="{DynamicResource AlbumSecondaryBrush}" Opacity="0.28" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    <Track.Thumb><Thumb Width="13" Height="13" Focusable="False"><Thumb.Template><ControlTemplate TargetType="Thumb"><Grid><Ellipse Fill="{DynamicResource AlbumSecondaryBrush}" Stroke="{DynamicResource AlbumPrimaryBrush}" StrokeThickness="2"/><Ellipse Width="3" Height="3" Fill="{DynamicResource AlbumPrimaryBrush}"/></Grid></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                </Track></Grid></ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Border x:Name="Shell" CornerRadius="10" BorderThickness="0" BorderBrush="{DynamicResource AlbumPrimaryBrush}" Background="#F8070B1C" MouseLeftButtonDown="Shell_MouseLeftButtonDown">
        <Grid ClipToBounds="False">
            <Grid.RowDefinitions><RowDefinition x:Name="PlaylistBarRow" Height="14"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Button x:Name="PlaylistPullButton" Grid.Row="0" Height="14" Padding="0" BorderThickness="0"
                    Background="{DynamicResource AlbumPrimaryBrush}" Foreground="#FF35103F" FontSize="6.5" FontWeight="Black"
                    Cursor="Hand" Click="PlaylistPullButton_Click" ToolTip="Open the music library">
                <Button.Template><ControlTemplate TargetType="Button">
                    <Border x:Name="PullBar" Background="{TemplateBinding Background}" CornerRadius="7,7,0,0" ClipToBounds="True">
                        <Grid>
                            <Border Background="#28FFFFFF" Height="1" VerticalAlignment="Bottom"/>
                            <TextBlock Text="CLICK TO PULL SONG LIST" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            <TextBlock x:Name="PullArrow" Text="⌃" FontSize="8" Foreground="#FF7C176D" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="PullBar" Property="Background" Value="#FFFF82D5"/></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="PullBar" Property="Background" Value="#FFFFB0E3"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate></Button.Template>
            </Button>
          <Grid Grid.Row="1" ClipToBounds="True">
          <Viewbox Stretch="Uniform">
           <Grid x:Name="DesignSurface" Width="410" Height="139" ClipToBounds="True">
            <local:SynthwaveBackground x:Name="SynthBackground" IsHitTestVisible="False"/>
            <Image x:Name="CustomBackgroundImage" Stretch="UniformToFill" Opacity="0.22" IsHitTestVisible="False" Visibility="Collapsed"/>
            <Grid Margin="8,6,8,6">
                <Grid.RowDefinitions><RowDefinition Height="19"/><RowDefinition Height="*"/><RowDefinition Height="22"/></Grid.RowDefinitions>
                <DockPanel Grid.Row="0" LastChildFill="False">
                    <StackPanel x:Name="BrandBlock" Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                        <Ellipse Width="7" Height="7" Fill="{DynamicResource AlbumPrimaryBrush}" Margin="0,0,9,0"/>
                        <TextBlock Text="WAVEPLAYER" Foreground="{StaticResource Ink}" FontSize="8" FontWeight="Bold"/>
                        <TextBlock Text="  •  STEREO FM 84" Foreground="#FFCE84FF" FontSize="7" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
                        <TextBlock x:Name="SourceStatus" Text="LOCAL LIBRARY" Foreground="#FFB5A8D2" FontSize="6" VerticalAlignment="Center" Margin="0,0,5,0" Width="64" TextTrimming="CharacterEllipsis"/>
                        <Button x:Name="SettingsControl" Style="{StaticResource HeaderControlButton}" Width="22" Height="19" ToolTip="Open settings" Click="SettingsButton_Click" Margin="0,0,3,0">
                            <Grid Width="13" Height="13">
                                <Path Data="M6.5,0.5 L6.5,2 M6.5,11 L6.5,12.5 M0.5,6.5 L2,6.5 M11,6.5 L12.5,6.5 M2.2,2.2 L3.3,3.3 M9.7,9.7 L10.8,10.8 M10.8,2.2 L9.7,3.3 M3.3,9.7 L2.2,10.8" Stroke="{DynamicResource AlbumSecondaryBrush}" StrokeThickness="1.3" StrokeStartLineCap="Round"/>
                                <Ellipse Width="6.5" Height="6.5" Stroke="#FFF9F4FF" StrokeThickness="1.3" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </Button>
                        <StackPanel x:Name="EqControls" Orientation="Horizontal">
                            <Button x:Name="EqButton" Style="{StaticResource HeaderControlButton}" Content="EQ" Width="30" Height="19" FontSize="8" FontWeight="Bold" Click="EqButton_Click" Margin="0,0,3,0" ToolTip="EQ for music played in this app"/>
                            <Button x:Name="EqResetButton" Style="{StaticResource HeaderControlButton}" Width="22" Height="19" Click="EqResetButton_Click" Margin="0,0,3,0" Visibility="Collapsed" ToolTip="Reset EQ to original sound">
                                <Path Data="M10.5,4.5 A5,5 0 1 0 11,10 M10.5,4.5 L10.5,1.5 M10.5,4.5 L7.5,4.5" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource AlbumSecondaryBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                            </Button>
                        </StackPanel>
                        <Button x:Name="RemixDemoButton" Style="{StaticResource RemixControlButton}" Width="58" Height="19" Click="RemixDemoButton_Click" Margin="0,0,3,0" ToolTip="Crossfade between local playlist tracks">
                            <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
                                <TextBlock Text="REMIX" FontSize="7.3" FontWeight="Bold" Foreground="#FFF9F3FF" HorizontalAlignment="Center"/>
                                <TextBlock x:Name="RemixMode" Text="DEMO" FontSize="5.2" FontWeight="Bold" Foreground="{DynamicResource AlbumSecondaryBrush}" HorizontalAlignment="Center" Margin="0,-1,0,0"/>
                            </StackPanel>
                        </Button>
                        <Button x:Name="PinButton" Style="{StaticResource HeaderControlButton}" Width="22" Height="19" FontSize="8" ToolTip="Pinned · click to unlock movement" Click="PinButton_Click" Margin="0,0,3,0">
                            <Path x:Name="PinIcon" Data="M5,2 L11,2 M6,2 L6,6 4,9 12,9 10,6 10,2 M8,9 L8,14" Width="11" Height="12" Stretch="Uniform" Stroke="{DynamicResource AlbumSecondaryBrush}" StrokeThickness="1.35" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                        </Button>
                        <Button x:Name="CloseControl" Style="{StaticResource CloseControlButton}" Width="22" Height="19" ToolTip="Close widget" Click="CloseButton_Click">
                            <Path Data="M3,3 L11,11 M11,3 L3,11" Width="10" Height="10" Stretch="Uniform" Stroke="#FFFFE2EB" StrokeThickness="1.7" StrokeStartLineCap="Round"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
                <Grid Grid.Row="1" Margin="0">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="86"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                    <Grid.RowDefinitions><RowDefinition Height="8"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Border x:Name="AlbumArtFrame" Grid.Row="1" Grid.Column="0" Width="78" Height="78" CornerRadius="9" BorderBrush="{DynamicResource AlbumPrimaryBrush}" BorderThickness="1.4" Background="#FF17102C" HorizontalAlignment="Left" VerticalAlignment="Center"
                            MouseLeftButtonDown="AlbumArtFrame_MouseLeftButtonDown" MouseMove="AlbumArtFrame_MouseMove"
                            MouseLeftButtonUp="AlbumArtFrame_MouseLeftButtonUp" LostMouseCapture="AlbumArtFrame_LostMouseCapture" Cursor="SizeNS">
                        <Grid SizeChanged="AlbumArtContent_SizeChanged"><Image x:Name="AlbumArtImage" Stretch="UniformToFill"/><Grid x:Name="FallbackCover">
                            <Grid.Background><LinearGradientBrush StartPoint="0,1" EndPoint="1,0"><GradientStop Color="#FF101A52" Offset="0"/><GradientStop Color="#FF74208A" Offset="0.55"/><GradientStop Color="#FFFF4F91" Offset="1"/></LinearGradientBrush></Grid.Background>
                            <Ellipse Width="42" Height="42" Fill="#FFFFA15F" Opacity=".96" VerticalAlignment="Top" Margin="0,6,0,0"/>
                            <TextBlock Text="CHILLWAVE" Foreground="White" FontSize="7" FontWeight="Black" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,10"/>
                            <TextBlock Text="NEON FM" Foreground="#FFFFDAEF" FontSize="5" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
                        </Grid><local:AlbumVolumeOverlay x:Name="AlbumVolume" IsHitTestVisible="False"/></Grid>
                    </Border>
                    <Grid Grid.Row="0" Grid.RowSpan="2" Grid.Column="1" Margin="6,0,0,0">
                        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="31"/></Grid.RowDefinitions>
                        <Border x:Name="SpectrumFrame" Grid.Row="0" CornerRadius="4" Background="#42100D25" BorderBrush="{DynamicResource AlbumSecondaryBrush}" BorderThickness="1" Padding="3,2">
                            <Grid x:Name="SpectrumLayers"><local:SpectrumView x:Name="Spectrum"/></Grid>
                        </Border>
                        <Grid Grid.Row="1" Margin="2,2,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel x:Name="TrackInfoBlock" VerticalAlignment="Center">
                                <TextBlock x:Name="TrackTitle" Text="Waiting for a track" Foreground="{StaticResource Ink}" FontSize="11" FontWeight="Bold" TextTrimming="CharacterEllipsis"/>
                                <TextBlock x:Name="ArtistName" Margin="0,1,0,0" Text="Choose a track from your playlist" Foreground="{DynamicResource AlbumPrimaryBrush}" FontSize="7" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="PreviousControl" Style="{StaticResource TransportControlButton}" Width="27" Height="27" ToolTip="Previous track" Click="PreviousButton_Click" Margin="0,0,4,0">
                                    <Path Data="M2,2 L5,2 5,16 2,16 Z M15,2 L15,16 6,9 Z" Width="15" Height="15" Stretch="Uniform" Fill="#FFF8F3FF"/>
                                </Button>
                                <Button x:Name="PlayPauseButton" Style="{StaticResource PrimaryControlButton}" Width="27" Height="27" ToolTip="Play or pause" Click="PlayPauseButton_Click" Margin="0,0,4,0">
                                    <Grid Width="17" Height="17">
                                        <Path x:Name="PlayIcon" Data="M4,2 L16,9.5 4,17 Z" Width="15" Height="15" Stretch="Uniform" Fill="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        <Path x:Name="PauseIcon" Data="M3,2 L7,2 7,17 3,17 Z M12,2 L16,2 16,17 12,17 Z" Width="15" Height="15" Stretch="Uniform" Fill="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                                    </Grid>
                                </Button>
                                <Button x:Name="NextControl" Style="{StaticResource TransportControlButton}" Width="27" Height="27" ToolTip="Next track" Click="NextButton_Click">
                                    <Path Data="M13,2 L16,2 16,16 13,16 Z M3,2 L12,9 3,16 Z" Width="15" Height="15" Stretch="Uniform" Fill="#FFF8F3FF"/>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Grid>
                <DockPanel Grid.Row="2" LastChildFill="True">
                    <TextBlock x:Name="AlbumName" DockPanel.Dock="Left" Text="Album art and track info appear here" Foreground="{StaticResource Muted}" FontSize="6" VerticalAlignment="Center" Width="80" TextTrimming="CharacterEllipsis"/>
                    <TextBlock x:Name="ElapsedText" DockPanel.Dock="Right" Text="0:00" Foreground="{StaticResource Muted}" FontSize="6" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <TextBlock x:Name="DurationText" DockPanel.Dock="Right" Text="—:—" Foreground="{StaticResource Muted}" FontSize="6" VerticalAlignment="Center" Margin="4,0,0,0"/>
                    <Slider x:Name="TrackProgress" Style="{StaticResource NeonSeekBar}" Minimum="0" Maximum="1000" Value="0" Height="14" VerticalAlignment="Center" Margin="5,0,0,0" PreviewMouseLeftButtonUp="TrackProgress_PreviewMouseLeftButtonUp"/>
                </DockPanel>
            </Grid>
            <Canvas x:Name="EditOverlay" Visibility="Collapsed" Panel.ZIndex="20">
                <Border x:Name="EditSelection" BorderBrush="#FF72DFFF" BorderThickness="1.5" CornerRadius="3"
                        Background="#183DCEFF" IsHitTestVisible="False" Visibility="Collapsed"/>
                <Thumb x:Name="EditResizeHandle" Width="11" Height="11" Cursor="SizeNWSE" Visibility="Collapsed">
                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="2" Background="#FFFF74DA" BorderBrush="White" BorderThickness="1"/></ControlTemplate></Thumb.Template>
                </Thumb>
            </Canvas>
           </Grid>
          </Viewbox>
          <Border CornerRadius="0,0,10,10" BorderThickness="1" BorderBrush="{DynamicResource AlbumPrimaryBrush}" Background="Transparent" IsHitTestVisible="False"/>
          </Grid>
          <Popup x:Name="PlaylistPopup" Placement="Top" PlacementTarget="{Binding ElementName=PlaylistPullButton}"
                 AllowsTransparency="True" StaysOpen="False" PopupAnimation="Fade"
                 Opened="PlaylistPopup_Opened" Closed="PlaylistPopup_Closed">
              <Border x:Name="PlaylistPanel" Width="410" Height="276" CornerRadius="15"
                      BorderThickness="1.5" BorderBrush="{DynamicResource AlbumPrimaryBrush}" Background="#EF17102F" Padding="0"
                      SnapsToDevicePixels="True">
                  <Border.Effect><DropShadowEffect Color="#FFFF39C6" BlurRadius="20" ShadowDepth="2" Opacity="0.45"/></Border.Effect>
                  <Viewbox Stretch="Fill">
                    <Grid Width="410" Height="276" ClipToBounds="True">
                      <local:SynthwaveBackground x:Name="PlaylistBackground" IsHitTestVisible="False" Opacity="0.85"/>
                      <Border Background="#B914102B" IsHitTestVisible="False"/>
                      <Grid Margin="8">
                          <Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition x:Name="PlaylistSourceRow" Height="0"/><RowDefinition Height="31"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                          <DockPanel Grid.Row="0" LastChildFill="False" Margin="4,0,2,2">
                              <StackPanel Orientation="Horizontal" DockPanel.Dock="Left" VerticalAlignment="Center">
                                  <TextBlock Text="♫" FontSize="14" Foreground="{DynamicResource AlbumPrimaryBrush}" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                  <TextBlock Text="PLAYLIST" FontSize="11" FontWeight="Bold" Foreground="#FFF5E5FF" VerticalAlignment="Center"/>
                              </StackPanel>
                              <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                                  <Border CornerRadius="8" Background="#421B3458" BorderBrush="#665A4C8B" BorderThickness="1" Padding="7,3" Margin="0,0,7,0">
                                      <TextBlock x:Name="PlaylistCount" Text="0 TRACKS" FontSize="7" FontWeight="Bold" Foreground="{DynamicResource AlbumSecondaryBrush}" VerticalAlignment="Center"/>
                                  </Border>
                                  <Button x:Name="PlaylistCollapseButton" Style="{StaticResource NeonButton}" Content="⌄" Width="21" Height="20" Padding="0" FontSize="12" Click="PlaylistCollapseButton_Click" ToolTip="Close playlist"/>
                              </StackPanel>
                          </DockPanel>
                          <Border Grid.Row="0" Height="1" Background="#615A4B91" VerticalAlignment="Bottom" Margin="3,0,3,0"/>
                          <ComboBox x:Name="PlaylistSourcePicker" Grid.Row="1" Style="{StaticResource NeonCombo}" FontSize="8"
                                    DisplayMemberPath="Name" SelectionChanged="PlaylistSourcePicker_SelectionChanged"
                                    Visibility="Collapsed" Margin="1,0,1,4" ToolTip="Choose all tracks or a saved playlist"/>
                          <Border Grid.Row="2" CornerRadius="7" BorderThickness="1" BorderBrush="#785F6EA0"
                                  Background="#B91A1835" Margin="1,1,1,5">
                              <Grid>
                                  <Grid.ColumnDefinitions><ColumnDefinition Width="25"/><ColumnDefinition Width="*"/><ColumnDefinition Width="26"/></Grid.ColumnDefinitions>
                                  <TextBlock Text="⌕" FontSize="16" Foreground="{DynamicResource AlbumSecondaryBrush}"
                                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                  <TextBox x:Name="PlaylistSearch" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                           Foreground="#FFF7EEFF" CaretBrush="#FF6CDEFF" FontSize="9" VerticalContentAlignment="Center"
                                           TextChanged="PlaylistSearch_TextChanged" ToolTip="Search title, artist, or filename"/>
                                  <TextBlock Grid.Column="1" IsHitTestVisible="False" Text="Search tracks or artists"
                                             FontSize="9" Foreground="#A5B8AED1" VerticalAlignment="Center" Margin="3,0,0,0">
                                      <TextBlock.Style><Style TargetType="TextBlock"><Setter Property="Visibility" Value="Collapsed"/>
                                          <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PlaylistSearch}" Value=""><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                      </Style></TextBlock.Style>
                                  </TextBlock>
                                  <Button x:Name="PlaylistSearchClear" Grid.Column="2" Content="×" Click="PlaylistSearchClear_Click"
                                          ToolTip="Clear search" FontSize="14">
                                      <Button.Style><Style TargetType="Button" BasedOn="{StaticResource PlaylistActionButton}">
                                          <Setter Property="Visibility" Value="Visible"/>
                                          <Style.Triggers><DataTrigger Binding="{Binding Text, ElementName=PlaylistSearch}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger></Style.Triggers>
                                      </Style></Button.Style>
                                  </Button>
                              </Grid>
                          </Border>
                          <ListBox x:Name="PlaylistItems" Grid.Row="3" VirtualizingPanel.ScrollUnit="Pixel" PreviewMouseLeftButtonUp="SortGrip_Up" LostMouseCapture="SortCaptureLost" ItemTemplate="{StaticResource PlaylistTrackTemplate}"
                                   ItemContainerStyle="{StaticResource PlaylistListItem}" Background="Transparent" BorderThickness="0"
                                   ScrollViewer.VerticalScrollBarVisibility="Auto" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                   ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True"
                                   VirtualizingPanel.VirtualizationMode="Recycling">
                              <ListBox.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource NeonScrollBar}"/></ListBox.Resources>
                          </ListBox>
                          <TextBlock Grid.Row="3" Text="NO TRACKS FOUND" IsHitTestVisible="False"
                                     Foreground="{DynamicResource AlbumSecondaryBrush}" FontSize="9" FontWeight="SemiBold"
                                     HorizontalAlignment="Center" VerticalAlignment="Center">
                              <TextBlock.Style><Style TargetType="TextBlock">
                                  <Setter Property="Visibility" Value="Collapsed"/>
                                  <Style.Triggers><DataTrigger Binding="{Binding HasItems, ElementName=PlaylistItems}" Value="False">
                                      <Setter Property="Visibility" Value="Visible"/>
                                  </DataTrigger></Style.Triggers>
                              </Style></TextBlock.Style>
                          </TextBlock>
                          <Canvas Grid.Row="3" ClipToBounds="True" IsHitTestVisible="False">
                              <ContentPresenter x:Name="DragPreview" ContentTemplate="{StaticResource PlaylistTrackTemplate}" Visibility="Collapsed"/>
                          </Canvas>
                      </Grid>
                    </Grid>
                  </Viewbox>
              </Border>
          </Popup>
          <Popup x:Name="EditToolbar" Placement="Bottom" PlacementTarget="{Binding ElementName=Shell}"
                 AllowsTransparency="True" StaysOpen="True" IsOpen="False">
              <Border Background="#F20E1028" BorderBrush="#FF72DFFF" BorderThickness="1" CornerRadius="7" Padding="8,5">
                  <StackPanel Orientation="Horizontal">
                      <TextBlock Text="EDIT MODE  ·  drag to move  ·  pull corner to resize" Foreground="#FFE8DDFB" FontSize="8" VerticalAlignment="Center" Margin="0,0,10,0"/>
                      <Button Style="{StaticResource NeonButton}" Content="RESET" FontSize="8" Padding="7,3" Click="EditReset_Click" Margin="0,0,4,0"/>
                      <Button Style="{StaticResource NeonButton}" Content="CANCEL" FontSize="8" Padding="7,3" Click="EditCancel_Click" Margin="0,0,4,0"/>
                      <Button Style="{StaticResource NeonButton}" Content="SAVE" FontSize="8" Padding="8,3" Click="EditSave_Click"/>
                  </StackPanel>
              </Border>
          </Popup>
        </Grid>
    </Border>
</Window>
