<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Waveplayer</AssemblyName>
    <Version>1.0.0</Version>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\Waveplayer.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Resource Include="$(ApplicationIcon)" />
    <Page Remove="Settings\SpectrumLab.xaml" />
    <EmbeddedResource Include="Settings\SpectrumLab.xaml" LogicalName="Settings.SpectrumLab.xaml" />
    <Content Include="Classic\SynthwaveNowPlaying.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <PackageReference Include="NAudio" Version="3.3.0" />
    <PackageReference Include="TagLibSharp" Version="2.3.0" />
  </ItemGroup>
</Project>
